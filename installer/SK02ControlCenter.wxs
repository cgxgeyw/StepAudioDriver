<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="SK02 Control Center"
           Manufacturer="SK02 Audio Driver"
           Version="1.0.0"
           UpgradeCode="E4E18DA1-362D-4004-855C-70E75CB38679"
           Scope="perUser"
           Compressed="yes"
           Language="2052"
           Codepage="936"
           InstallerVersion="500">

    <SummaryInformation Description="SK02 Control Center 安装程序"
                        Manufacturer="SK02 Audio Driver" />

    <MajorUpgrade DowngradeErrorMessage="已安装更新版本的 SK02 Control Center，请先卸载旧版本。" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon.exe" SourceFile="$(sys.SOURCEFILEDIR)..\src\SK02.UI\Assets\sk02.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.exe" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPCOMMENTS" Value="SK02 控制中心" />

    <Launch Condition="VersionNT64" Message="SK02 Control Center 需要 64 位 Windows 10/11。" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="SK02 Control Center" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="SK02 Control Center" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="MainFeature" Title="SK02 Control Center" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(sys.SOURCEFILEDIR)..\artifacts\publish\win-x64\**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="StartMenuShortcut" Directory="AppMenuFolder">
      <Shortcut Id="StartMenuShortcutLink"
                Name="SK02 Control Center"
                Description="SK02 控制中心"
                Target="[INSTALLFOLDER]SK02.UI.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.exe" />
      <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\SK02AudioDriver"
                     Name="StartMenuShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder">
      <Shortcut Id="DesktopShortcutLink"
                Name="SK02 Control Center"
                Description="SK02 控制中心"
                Target="[INSTALLFOLDER]SK02.UI.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.exe" />
      <RegistryValue Root="HKCU"
                     Key="Software\SK02AudioDriver"
                     Name="DesktopShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>

</Wix>
