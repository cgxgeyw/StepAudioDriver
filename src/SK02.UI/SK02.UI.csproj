<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <AssemblyName>SK02.UI</AssemblyName>
    <RootNamespace>SK02.UI</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>cgxgeyw</Authors>
    <Product>SK02 Control Center</Product>
    <Description>Virtual 7.1 HRTF audio control center for Fosi Audio SK02 and other WASAPI devices.</Description>
    <RepositoryUrl>https://github.com/cgxgeyw/SK02AudioDriver</RepositoryUrl>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\sk02.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF UI 框架 -->
    <PackageReference Include="MahApps.Metro" Version="2.4.10" />
    <PackageReference Include="MahApps.Metro.IconPacks" Version="4.11.0" />

    <!-- 依赖注入 -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />

    <!-- MVVM -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />

    <!-- 日志 -->
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="2.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />

    <!-- JSON 配置 -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SK02.Core\SK02.Core.csproj" />
    <ProjectReference Include="..\SK02.Service\SK02.Service.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\sk02.ico" />
    <None Include="native\sk02_dsp.dll" CopyToOutputDirectory="PreserveNewest" Link="sk02_dsp.dll" />
    <Folder Include="Resources\" />
  </ItemGroup>

</Project>
