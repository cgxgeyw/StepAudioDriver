<Window x:Class="Step.UI.DirectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Step Sound Field"
        Width="200" Height="232"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI">

    <Border x:Name="RootBorder"
            Background="#F216181D"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="16"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="170"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="13,4,7,0">
                <TextBlock Text="STEP 声场"
                           FontSize="11.5"
                           Foreground="#CCFFFFFF"
                           VerticalAlignment="Center"/>
                <Button x:Name="CloseButton"
                        Content="×"
                        Width="24" Height="24"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#88FFFFFF"
                        FontSize="15"
                        Padding="0"
                        Click="CloseButton_Click"/>
            </Grid>

            <Canvas x:Name="RadarCanvas"
                    Grid.Row="1"
                    Width="170" Height="170"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <Ellipse Width="160" Height="160" Canvas.Left="5" Canvas.Top="5"
                         Fill="#22000000" Stroke="#33FFFFFF" StrokeThickness="1"/>
                <Ellipse Width="120" Height="120" Canvas.Left="25" Canvas.Top="25"
                         Stroke="#22FFFFFF" StrokeThickness="1"/>
                <Ellipse Width="80" Height="80" Canvas.Left="45" Canvas.Top="45"
                         Stroke="#22FFFFFF" StrokeThickness="1"/>

                <Line X1="85" Y1="12" X2="85" Y2="158" Stroke="#22FFFFFF" StrokeThickness="1"/>
                <Line X1="12" Y1="85" X2="158" Y2="85" Stroke="#22FFFFFF" StrokeThickness="1"/>

                <TextBlock Text="前" FontSize="10" Foreground="#88FFFFFF"
                           Canvas.Left="79" Canvas.Top="3"/>
                <TextBlock Text="后" FontSize="10" Foreground="#88FFFFFF"
                           Canvas.Left="79" Canvas.Top="153"/>
                <TextBlock Text="左" FontSize="10" Foreground="#88FFFFFF"
                           Canvas.Left="4" Canvas.Top="79"/>
                <TextBlock Text="右" FontSize="10" Foreground="#88FFFFFF"
                           Canvas.Left="160" Canvas.Top="79"/>

                <Line x:Name="DirectionLine"
                      X1="85" Y1="85" X2="85" Y2="85"
                      Stroke="#FFD08A" StrokeThickness="2"
                      StrokeEndLineCap="Round"
                      Opacity="0.25"/>

                <Ellipse x:Name="DirectionDot"
                         Width="12" Height="12"
                         Canvas.Left="79" Canvas.Top="79"
                         Fill="#FFD08A"
                         Opacity="0.25">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#FFD08A" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>

            <TextBlock x:Name="DirectionText"
                       Grid.Row="2"
                       Text="—"
                       FontSize="11"
                       Foreground="#AAFFFFFF"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
